{
  "name": "@arcsyn-shift/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit --target ES2021",
    "test": "vitest run --passWithNoTests",
    "module:create": "node scripts/create-module.mjs",
    "architecture:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@arcsyn-shift/config": "workspace:*",
    "@arcsyn-shift/contracts": "workspace:*",
    "@arcsyn-shift/database": "workspace:*",
    "@arcsyn-shift/observability": "workspace:*",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@arcsyn-shift/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
